# TeXada — backend configuration examples
#
# These mirror the TEXADA_-prefixed env vars read by the Python backend
# (see src/texada/config.py) and the Tauri desktop shell. For persistent
# user settings prefer ~/.texada/config.json; this file is illustrative —
# dotenv loading is NOT enabled by default, so to use these, export them
# in your shell.

# ── Ollama backend ──
TEXADA_BACKEND=ollama
TEXADA_OLLAMA_HOST=http://localhost:11434
TEXADA_MODEL_NAME=hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
TEXADA_VISION_MODEL_NAME=openbmb/minicpm-v4.6:latest

# ── OpenAI-compatible cloud backend ──
# TEXADA_BACKEND=openai_compatible
# TEXADA_OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
# TEXADA_OPENAI_MODEL_NAME=step-3.7-flash
# TEXADA_OPENAI_VISION_MODEL_NAME=step-3.7-flash
# TEXADA_OPENAI_API_KEY=replace-with-your-key
# TEXADA_NL_CANDIDATE_FIRST=true
# TEXADA_OCR_PREPROCESSING=raw

# ── MiniCPM-V 4.7 single-checkpoint iteration (opt in) ──
# Export your key separately, then run ./scripts/run-minicpm-v47.sh.
# The launcher selects these settings without changing saved user settings:
# export TEXADA_BACKEND=openai_compatible
# export TEXADA_OPENAI_BASE_URL=https://api.modelbest.cn/v1
# export TEXADA_OPENAI_MODEL_NAME=MiniCPM-V-4.7-1B
# export TEXADA_OPENAI_VISION_MODEL_NAME=MiniCPM-V-4.7-1B
# export TEXADA_OPENAI_API_KEY=replace-with-your-key
# For an externally managed Q4 llama-server, keep both model roles identical
# and start the server with --alias MiniCPM-V-4.7-1B. Then override:
# export TEXADA_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# export TEXADA_OPENAI_API_KEY=local-no-key
# Q4 is an optional precision/transport path, not a second model; quality
# must be evaluated separately. This file is not loaded automatically.

# ── Inference ──
TEXADA_TEMPERATURE=0.1
# Planner response budget. Local MiniCPM5-2B text requests disable thinking;
# formula generation and completion use at most 768 output tokens.
TEXADA_MAX_TOKENS=2048
TEXADA_INFERENCE_TIMEOUT_SECONDS=90
TEXADA_API_REQUEST_TIMEOUT_SECONDS=240

# ── Agent Runtime ──
TEXADA_AGENT_MAX_STEPS=3

# ── Run logs ──
# 0 means unlimited. Set either value to a positive integer to enable cleanup.
TEXADA_RUN_LOG_MAX_DAYS=0
TEXADA_RUN_LOG_MAX_ITEMS=0

# ── Server ──
TEXADA_API_HOST=127.0.0.1
TEXADA_API_PORT=18732
# The desktop shell calls TeXada FastAPI through this base URL. This is not
# the Ollama address; Ollama defaults to TEXADA_OLLAMA_HOST above.
TEXADA_API_BASE=http://127.0.0.1:18732
# Set this to 1 only if you manage the FastAPI backend outside the packaged app.
# TEXADA_DISABLE_BUNDLED_BACKEND=1
TEXADA_API_TIMEOUT_SECS=240

# ── UI ──
TEXADA_UI_LANGUAGE=zh
TEXADA_UI_ZOOM=1.0
