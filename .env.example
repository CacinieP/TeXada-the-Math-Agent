# TeXada — Ollama backend (MiniCPM)
#
# These mirror the TEXADA_-prefixed env vars read by the Python backend
# (see src/texada/config.py) and the Tauri desktop shell. For persistent
# user settings prefer ~/.texada/config.json; this file is illustrative —
# dotenv loading is NOT enabled by default, so to use these, export them
# in your shell.

# ── Ollama backend ──
TEXADA_BACKEND=ollama
TEXADA_OLLAMA_HOST=http://localhost:11434
TEXADA_MODEL_NAME=hf.co/openbmb/MiniCPM5-1B-GGUF:Q4_K_M
TEXADA_VISION_MODEL_NAME=openbmb/minicpm-v4.6:latest

# ── OpenAI-compatible cloud backend ──
# TEXADA_BACKEND=openai_compatible
# TEXADA_OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
# TEXADA_OPENAI_MODEL_NAME=step-3.7-flash
# TEXADA_OPENAI_VISION_MODEL_NAME=step-3.7-flash
# TEXADA_OPENAI_API_KEY=replace-with-your-key

# ── Inference ──
TEXADA_TEMPERATURE=0.1
# MiniCPM5 is a reasoning model — CoT needs headroom, keep >= 2048
TEXADA_MAX_TOKENS=2048
TEXADA_INFERENCE_TIMEOUT_SECONDS=45
TEXADA_API_REQUEST_TIMEOUT_SECONDS=120

# ── Server ──
TEXADA_API_HOST=127.0.0.1
TEXADA_API_PORT=18732
# The desktop shell calls TeXada FastAPI through this base URL. This is not
# the Ollama address; Ollama defaults to TEXADA_OLLAMA_HOST above.
TEXADA_API_BASE=http://127.0.0.1:18732
# Set this to 1 only if you manage the FastAPI backend outside the packaged app.
# TEXADA_DISABLE_BUNDLED_BACKEND=1
TEXADA_API_TIMEOUT_SECS=120

# ── UI ──
TEXADA_UI_LANGUAGE=zh
TEXADA_UI_ZOOM=1.0
