# TeXada — Ollama backend (MiniCPM)
#
# These mirror the TEXADA_-prefixed env vars pydantic-settings reads
# (see src/texada/config.py). For persistent config prefer ~/.texada/config.json;
# this file is illustrative — dotenv loading is NOT enabled by default, so to
# use these, export them in your shell.

# ── Ollama backend ──
TEXADA_OLLAMA_HOST=http://localhost:11434
TEXADA_MODEL_NAME=hf.co/openbmb/MiniCPM5-1B-GGUF:Q4_K_M
TEXADA_VISION_MODEL_NAME=openbmb/minicpm-v4.6:latest

# ── Inference ──
TEXADA_TEMPERATURE=0.1
# MiniCPM5 is a reasoning model — CoT needs headroom, keep >= 2048
TEXADA_MAX_TOKENS=2048

# ── Server ──
TEXADA_API_HOST=127.0.0.1
TEXADA_API_PORT=18732
TEXADA_WEB_HOST=127.0.0.1
TEXADA_WEB_PORT=5173
TEXADA_API_BASE=http://127.0.0.1:18732

# ── UI ──
TEXADA_UI_LANGUAGE=zh
TEXADA_UI_ZOOM=1.0
