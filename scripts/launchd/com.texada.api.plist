<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.texada.api</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Three launchd-specific workarounds, all required:
             1. `cd /; cd PROJECT` — launchd starts the process with a cwd
                the agent can't access, so the first getcwd fails and any
                single `cd` chains that failure. Resetting to `/` first
                breaks the chain, then we enter the project dir.
             2. Direct `uvicorn --factory`, bypassing the `texada` typer CLI
                — typer/click blocks on terminal init with no TTY under launchd.
             3. `--loop asyncio` — uvicorn[standard]'s default uvloop deadlocks
                under launchd's background session.
             PYTHONUNBUFFERED + python -u flush logs in real time. -->
        <string>/bin/sh</string>
        <string>-c</string>
        <string>cd /; cd "{{PROJECT_ROOT}}"; PYTHONUNBUFFERED=1 "{{PROJECT_ROOT}}/.venv/bin/python" -u -m uvicorn texada.api:create_app --factory --host 127.0.0.1 --port 18732 --loop asyncio</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/api-service.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/api-service.log</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
